# 服务监听端口
PORT=25580

# 整合包技术标识（与客户端清单匹配）
PACK_ID=example-pack

# 系统显示名称
APP_NAME=ModSync 更新发布器

# 客户端默认访问地址（选填，用于一键生成客户端更新器时的预填默认值）
CLIENT_ENDPOINT=http://192.168.1.100:25580

# 宿主机 Mod 存放目录（容器只读挂载源路径）
HOST_MODS_DIR=./client_mods

# 管理员后台密码（用于网页登录与发布）
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# 客户端只读下载 Token（供客户端 Mod 调用接口时使用）
CLIENT_TOKEN=change_this_to_a_secure_client_token

# 安全与限流配置
RATE_LIMIT_RPS=60
MAX_CONCURRENT_DOWNLOADS=10
